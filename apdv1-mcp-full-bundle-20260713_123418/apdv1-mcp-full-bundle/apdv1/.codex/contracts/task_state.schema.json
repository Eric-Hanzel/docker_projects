{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apdv1.local/contracts/task_state.schema.json",
  "title": "APDv1 task state",
  "type": "object",
  "required": ["status", "updated_at"],
  "additionalProperties": true,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "RUNNING",
        "COMPLETED_SUCCESS",
        "COMPLETED_CONDITIONAL_SUCCESS",
        "COMPLETED_FAILED",
        "TIMED_OUT",
        "ABORTED",
        "IDLE",
        "INITIALIZING",
        "STARTING"
      ]
    },
    "delivery_mode": {
      "type": "string",
      "enum": ["local-run", "portable-deliverable", "meta-refactor"]
    },
    "portable_final_required": {
      "type": ["boolean", "string"]
    },
    "project_name": {
      "type": "string"
    },
    "cleanup_project_names": {
      "type": ["string", "array"],
      "items": {"type": "string"}
    },
    "audit_verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "CONDITIONAL"]
    },
    "audit_result_file": {
      "type": "string"
    },
    "conditional_reason": {
      "type": "string"
    },
    "blocking_requirement": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "COMPLETED_CONDITIONAL_SUCCESS"}}
      },
      "then": {
        "required": ["conditional_reason", "blocking_requirement"]
      }
    }
  ]
}
