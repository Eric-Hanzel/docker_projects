{
  "version": 1,
  "description": "Policy for preserving reusable Docker cache while removing APDv1 task artifacts.",
  "keep_repositories": [
    "alpine",
    "alpine/socat",
    "busybox",
    "debian",
    "ubuntu",
    "docker",
    "golang",
    "maven",
    "node",
    "python",
    "ruby",
    "eclipse-temurin",
    "postgres",
    "mariadb",
    "mysql",
    "mongo",
    "redis",
    "memcached",
    "httpd",
    "nginx",
    "caddy",
    "traefik",
    "kong/kong",
    "zookeeper",
    "timberio/vector",
    "percona/mongodb_exporter",
    "natsio/prometheus-nats-exporter",
    "postgrest/postgrest",
    "cgr.dev/chainguard/wolfi-base",
    "ghcr.io/dexidp/dex",
    "agiledigital/postfix",
    "crazymax/msmtpd",
    "mcuadros/ofelia",
    "darthsim/imgproxy",
    "chrislusf/seaweedfs",
    "bitnamilegacy/openldap",
    "registry.dagger.io/engine",
    "earthly/buildkitd",
    "openwrt/imagebuilder",
    "openwrt/rootfs",
    "kindest/node",
    "brigadecore/kind-node",
    "gcr.io/k8s-minikube/kicbase",
    "rancher/k3s",
    "ghcr.io/k3d-io/k3d-proxy",
    "ghcr.io/k3d-io/k3d-tools"
  ],
  "remove_name_patterns": [
    "(^|[-_/])final($|[-_:])",
    "[:_-]final($|[-_:])",
    "(^|[-_/])bundle($|[-_:])",
    "[:_-]bundle($|[-_:])",
    "^netdatafinal$",
    "^netdatafinal:",
    "^draft-draft-redis($|:)",
    "^hello-world:"
  ],
  "review_repositories": [
    "jetbrains/teamcity-server",
    "jetbrains/teamcity-agent",
    "checkmk/check-mk-community",
    "supabase/",
    "docker.elastic.co/",
    "opensearchproject/opensearch",
    "screwdrivercd/",
    "brigadecore/brigade2-",
    "ghcr.io/mailcow/",
    "ghcr.io/mailu/",
    "dpage/pgadmin4",
    "jenkins/jenkins",
    "quay.io/keycloak/keycloak",
    "temporalio/temporal",
    "nacos/nacos-server",
    "mattermost/mattermost-team-edition",
    "jitsi/",
    "portainer/portainer-ce",
    "djmaze/snappymail",
    "ghcr.io/the-djmaze/snappymail",
    "dragonflyoss/",
    "graylog/graylog",
    "sonatype/nexus3",
    "docker.gitea.com/gitea",
    "librenms/librenms",
    "ipfs/kubo",
    "pinpointdocker/pinpoint-agent",
    "pinpointdocker/pinpoint-flink",
    "pinpointdocker/pinpoint-quickstart",
    "ghcr.io/emissary-ingress/emissary"
  ],
  "notes": [
    "Keep list is intentionally biased toward OS, language, database, cache, web server, exporters, and local Kubernetes/build-tool images.",
    "Remove patterns target APDv1-produced runnable deliverable images such as sogo-5-12-8-final-sogo:latest.",
    "Review repositories are complete products or suites; they are not generic build cache, but may be kept when repeated deployments are expected."
  ]
}
